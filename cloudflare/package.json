{
  "name": "divinum-officium-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "assets": "python3 tools/sync_assets.py",
    "calendar": "python3 tools/build_calendar.py --repo .. --years 2025,2026,2027",
    "build": "bun run assets && bun run calendar",
    "dev": "alchemy dev",
    "deploy": "alchemy deploy --yes",
    "deploy:prod": "alchemy deploy --stage prod --yes",
    "destroy": "alchemy destroy",
    "parity": "bun tools/parity.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "effect": "^4.0.0-rc.111"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@effect/platform-bun": "^4.0.0-rc.111",
    "alchemy": "2.0.0-beta.79",
    "typescript": "^7.0.2",
    "@effect/platform-node": "^4.0.0-rc.111"
  }
}
